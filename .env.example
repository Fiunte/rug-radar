# Copy to .env (make setup does this). Never commit .env.
HELIUS_API_KEY=
ALCHEMY_API_KEY=
# Optional: emergency RPC tier, used only when Helius and Alchemy both fail.
# Paste the dashboard's "RPC" value (a full https:// URL). It wins over FLUXRPC_API_KEY.
FLUXRPC_RPC_URL=
FLUXRPC_API_KEY=
# Optional: FluxRPC websocket URL (dashboard "WebSocket" value). Default: wss://ws.eu.fluxrpc.com?key=<API key>.
# Used only when the public RPC rate-limits the create-log stream (decision D-33).
FLUXRPC_WS_URL=
# Scanners (enabled on day 3). RugCheck works without a key; a key is optional.
# GoPlus is queried on its public tier in M1; the key is not read yet (see docs/decisions.md).
GOPLUS_API_KEY=
SOLANATRACKER_API_KEY=
RUGCHECK_API_KEY=
# Optional: day of month on which the Helius credit counter resets (default 1).
HELIUS_BILLING_DAY=
